{
  "name": "grokeado",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:mock": "node scripts/dev-mock.mjs",
    "build": "next build && node scripts/check-playwright-traces.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:gateway": "node --import tsx scripts/test-gateway.ts",
    "test:court": "node --import tsx scripts/test-court.ts",
    "test:evals": "node --import tsx --test \"evals/*/*.test.ts\"",
    "evidence:snapshot": "node --import tsx scripts/evidence-snapshot.ts",
    "evidence:smoke": "node --import tsx scripts/evidence-blob-smoke.ts",
    "evidence:migrate-r2": "node --import tsx scripts/migrate-blob-to-r2.ts",
    "eval:tiers": "node --import tsx scripts/eval-tiers.ts",
    "eval:research": "node --import tsx scripts/eval-research.ts",
    "models": "node scripts/models.mjs",
    "cases:regenerate-ids": "node --import tsx scripts/regenerate-case-ids.ts",
    "cases:covers": "node --import tsx scripts/generate-covers.ts"
  },
  "dependencies": {
    "@ai-sdk/xai": "^5.0.33",
    "@auth0/nextjs-auth0": "^4.33.0",
    "@browserbasehq/sdk": "^2.24.0",
    "@next/env": "^16.4.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.219.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/instrumentation": "^0.219.0",
    "@opentelemetry/resources": "~2.12.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "~2.12.0",
    "@opentelemetry/sdk-trace-base": "~2.12.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.5",
    "@vercel/oidc": "4.0.5",
    "@vercel/otel": "^2.3.0",
    "@vercel/sandbox": "^3.9.1",
    "ai": "^7.0.157",
    "defuddle": "^0.19.6",
    "impit": "^0.14.8",
    "linkedom": "^0.18.14",
    "markdown-it": "^15.0.3",
    "next": "^16.4.3",
    "pele": "^1.13.0",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "workflow": "^5.2.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "zod": "$zod",
    "minimatch": "^11.0.4",
    "@workflow/world-local": {
      "undici": "7.30.1"
    },
    "@workflow/world-vercel": {
      "undici": "7.30.1"
    }
  }
}
